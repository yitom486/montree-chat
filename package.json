{
  "name": "montree-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Montree chat SDK: protocol contracts, annotations, reader-core, chat-core, chat-ui, chat-session",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:ext": "bun scripts/check-ext.ts",
    "build": "bun scripts/build.ts",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "happy-dom": "^20.11.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
