      "types": "./dist/ui/chat-markdown.lazy.d.ts",
      "default": "./dist/ui/chat-markdown.lazy.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
